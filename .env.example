# ==============================================================================
# ENVIRONMENT VARIABLES & DOKUMENTASI SUPABASE — ONLINE STORE (TAHAP 1)
# ==============================================================================

# SUPABASE URL: Project URL dari dashboard Supabase Anda
# Temukan di: Project Settings -> API -> Project URL
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE ANON KEY: Kunci akses publik anon (Aman untuk frontend)
# Temukan di: Project Settings -> API -> Project API keys -> anon (public)
# PERINGATAN KEAMANAN: JANGAN PERNAH memasukkan 'service_role' secret key di sini!
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ==============================================================================
# PAYMENT GATEWAY CONFIGURATION (TAHAP 4)
# ==============================================================================
# Payment Provider default: 'midtrans' atau 'xendit' atau 'simulator'
PAYMENT_PROVIDER="midtrans"

# Midtrans Configuration (Server key bersifat RAHASIA, hanya untuk Backend / Edge Function)
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY"
# Client key bersifat publik untuk Midtrans Snap JS di frontend browser
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION="false"

# Xendit Configuration (Opsional / Provider Agnostic)
XENDIT_SECRET_KEY="xnd_development_YOUR_SECRET_KEY"

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ==============================================================================
# PANDUAN LENGKAP SETUP SUPABASE POSTGRESQL & STORAGE
# ==============================================================================
#
# 1. CARA MEMBUAT PROJECT SUPABASE:
#    a. Buka https://supabase.com dan masuk ke akun Anda.
#    b. Klik "New Project", pilih organisasi Anda.
#    c. Masukkan nama project (contoh: "fmcg-online-store"), buat database password yang kuat,
#       dan pilih region cloud terdekat (contoh: Singapore [ap-southeast-1]).
#    d. Tunggu sekitar 1-2 menit hingga provisioning database selesai.
#
# 2. CARA MEMBUAT DATABASE & MENJALANKAN SQL SCHEMA:
#    a. Pada menu sidebar dashboard Supabase, buka menu "SQL Editor".
#    b. Klik "+ New query".
#    c. Salin seluruh isi dari file: supabase/schema.sql
#    d. Tempelkan ke SQL Editor lalu klik tombol "Run".
#    e. Tabel 'categories', 'brands', 'products', 'product_images', 'carts', 'cart_items',
#       trigger updated_at, dan RLS policies akan otomatis terbuat.
#
# 3. CARA MENJALANKAN SEED DATA:
#    a. Di SQL Editor, buat query baru ("+ New query").
#    b. Salin seluruh isi dari file: supabase/seed.sql
#    c. Tempelkan dan klik tombol "Run".
#    d. Seluruh data awal komoditas (Kurma Ajwa, Sukari, Wijen, Bawang, Kacang, Kemiri)
#       akan terisi secara instan ke PostgreSQL.
#
# 4. CARA MEMBUAT STORAGE BUCKET:
#    a. Schema SQL di atas sudah otomatis mengeksekusi pembuatan bucket 'product-images'.
#    b. Namun Anda juga dapat memverifikasi di menu "Storage" -> "Buckets".
#    c. Pastikan bucket 'product-images' berstatus "Public" agar foto produk dapat diakses
#       oleh browser pembeli tanpa token berbayar.
#
# 5. CARA MEMASUKKAN ENVIRONMENT VARIABLES:
#    a. Buat salinan file ini dan beri nama: .env
#    b. Masukkan nilai VITE_SUPABASE_URL dan VITE_SUPABASE_ANON_KEY asli Anda.
#    c. Simpan file .env.
#
# 6. CARA MENJALANKAN APLIKASI (DEVELOPMENT):
#    $ npm run dev
#    Buka browser di http://localhost:3000
#
# 7. CARA BUILD PRODUCTION:
#    $ npm run build
#    Untuk pratinjau hasil build: $ npm run preview
# ==============================================================================
